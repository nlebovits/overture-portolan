{
  // Static-asset deploy. There is deliberately no "main" entrypoint: this
  // project serves the catalog tree and runs no Worker code. That matters for
  // headers, because Cloudflare does not apply catalog/_headers to responses
  // generated by a Worker script. Adding "main" here would silently stop the
  // CORS and range policy from reaching clients.
  //
  // "directory" must match PUBLISH_DIR in tools/catalog_config.py. The two are
  // the same fact recorded in two places, and disagreement publishes the wrong
  // tree.
  //
  // See docs/publication.md for why this catalog deploys from git.
  "name": "overture-portolan",
  "compatibility_date": "2026-08-27",
  "assets": {
    "directory": "./catalog"
  }
}
