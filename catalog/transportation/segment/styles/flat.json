{
  "version": 8,
  "name": "Segment, single colour",
  "sources": {
    "overture": {
      "type": "vector",
      "tiles": [
        "pmtiles://https://overturemaps-extras-us-west-2.s3.us-west-2.amazonaws.com/tiles/2026-08-19.0/transportation.pmtiles/{z}/{x}/{y}"
      ],
      "minzoom": 0,
      "maxzoom": 14,
      "attribution": "<a href=\"https://overturemaps.org/\">Overture Maps</a>, &copy; OpenStreetMap contributors"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#101418"
      }
    },
    {
      "id": "segment-line",
      "type": "line",
      "source": "overture",
      "source-layer": "segment",
      "filter": [
        "==",
        [
          "geometry-type"
        ],
        "LineString"
      ],
      "paint": {
        "line-color": "#2a9d8f",
        "line-width": 1.1
      }
    }
  ]
}
