{
  "version": 8,
  "name": "Building Part by roof_shape",
  "sources": {
    "overture": {
      "type": "vector",
      "tiles": [
        "pmtiles://https://overturemaps-extras-us-west-2.s3.us-west-2.amazonaws.com/tiles/2026-08-19.0/buildings.pmtiles/{z}/{x}/{y}"
      ],
      "minzoom": 0,
      "maxzoom": 14,
      "attribution": "<a href=\"https://overturemaps.org/\">Overture Maps</a>, &copy; OpenStreetMap contributors"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#101418"
      }
    },
    {
      "id": "building_part-fill",
      "type": "fill",
      "source": "overture",
      "source-layer": "building_part",
      "paint": {
        "fill-color": [
          "match",
          [
            "get",
            "roof_shape"
          ],
          "flat",
          "#e8a33d",
          "gabled",
          "#c1553b",
          "skillion",
          "#7f5539",
          "hipped",
          "#b08968",
          "pyramidal",
          "#ddb892",
          "dome",
          "#9c6644",
          "round",
          "#e6ccb2",
          "half_hipped",
          "#a68a64",
          "onion",
          "#c2a878",
          "mansard",
          "#8a6f4a",
          "#9e9e9e"
        ],
        "fill-opacity": 0.85
      }
    },
    {
      "id": "building_part-outline",
      "type": "line",
      "source": "overture",
      "source-layer": "building_part",
      "filter": [
        "==",
        [
          "geometry-type"
        ],
        "Polygon"
      ],
      "paint": {
        "line-color": "#101418",
        "line-width": 0.3
      }
    }
  ]
}
