{
  "version": 8,
  "name": "Division Area by subtype",
  "sources": {
    "overture": {
      "type": "vector",
      "tiles": [
        "pmtiles://https://overturemaps-extras-us-west-2.s3.us-west-2.amazonaws.com/tiles/2026-08-19.0/divisions.pmtiles/{z}/{x}/{y}"
      ],
      "minzoom": 0,
      "maxzoom": 12,
      "attribution": "<a href=\"https://overturemaps.org/\">Overture Maps</a>, &copy; OpenStreetMap contributors"
    }
  },
  "layers": [
    {
      "id": "division_area-fill",
      "type": "fill",
      "source": "overture",
      "source-layer": "division_area",
      "paint": {
        "fill-color": [
          "match",
          [
            "get",
            "subtype"
          ],
          "locality",
          "#7fb3d0",
          "neighborhood",
          "#95c68f",
          "microhood",
          "#c98bab",
          "macrohood",
          "#a99bd0",
          "county",
          "#e89d07",
          "localadmin",
          "#4a9d9c",
          "region",
          "#5591b5",
          "country",
          "#174054",
          "dependency",
          "#9aa3a8",
          "#9e9e9e"
        ],
        "fill-opacity": 0.85
      }
    },
    {
      "id": "division_area-outline",
      "type": "line",
      "source": "overture",
      "source-layer": "division_area",
      "filter": [
        "==",
        [
          "geometry-type"
        ],
        "Polygon"
      ],
      "paint": {
        "line-color": "#FFFFFF",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          5,
          0,
          7,
          0.3
        ]
      }
    }
  ]
}
