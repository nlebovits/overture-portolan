{
  "version": 8,
  "name": "Division by subtype",
  "sources": {
    "overture": {
      "type": "vector",
      "tiles": [
        "pmtiles://https://overturemaps-extras-us-west-2.s3.us-west-2.amazonaws.com/tiles/2026-08-19.0/divisions.pmtiles/{z}/{x}/{y}"
      ],
      "minzoom": 0,
      "maxzoom": 12,
      "attribution": "<a href=\"https://overturemaps.org/\">Overture Maps</a>, &copy; OpenStreetMap contributors"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#101418"
      }
    },
    {
      "id": "division-point",
      "type": "circle",
      "source": "overture",
      "source-layer": "division",
      "filter": [
        "==",
        [
          "geometry-type"
        ],
        "Point"
      ],
      "paint": {
        "circle-color": [
          "match",
          [
            "get",
            "subtype"
          ],
          "locality",
          "#4c72b0",
          "neighborhood",
          "#dd8452",
          "microhood",
          "#55a868",
          "macrohood",
          "#c44e52",
          "county",
          "#8172b3",
          "localadmin",
          "#937860",
          "region",
          "#da8bc3",
          "country",
          "#e8c547",
          "dependency",
          "#ccb974",
          "#9e9e9e"
        ],
        "circle-radius": 2.4,
        "circle-opacity": 0.9
      }
    }
  ]
}
