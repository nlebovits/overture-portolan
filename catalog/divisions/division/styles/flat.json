{
  "version": 8,
  "name": "Division, single colour",
  "sources": {
    "overture": {
      "type": "vector",
      "tiles": [
        "pmtiles://https://overturemaps-extras-us-west-2.s3.us-west-2.amazonaws.com/tiles/2026-08-19.0/divisions.pmtiles/{z}/{x}/{y}"
      ],
      "minzoom": 0,
      "maxzoom": 12,
      "attribution": "<a href=\"https://overturemaps.org/\">Overture Maps</a>, &copy; OpenStreetMap contributors"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#101418"
      }
    },
    {
      "id": "division-point",
      "type": "circle",
      "source": "overture",
      "source-layer": "division",
      "filter": [
        "==",
        [
          "geometry-type"
        ],
        "Point"
      ],
      "paint": {
        "circle-color": "#4c72b0",
        "circle-radius": 2.4,
        "circle-opacity": 0.9
      }
    }
  ]
}
