{
  "version": 8,
  "name": "Infrastructure by surface",
  "sources": {
    "overture": {
      "type": "vector",
      "tiles": [
        "pmtiles://https://overturemaps-extras-us-west-2.s3.us-west-2.amazonaws.com/tiles/2026-08-19.0/base.pmtiles/{z}/{x}/{y}"
      ],
      "minzoom": 0,
      "maxzoom": 13,
      "attribution": "<a href=\"https://overturemaps.org/\">Overture Maps</a>, &copy; OpenStreetMap contributors"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#101418"
      }
    },
    {
      "id": "infrastructure-fill",
      "type": "fill",
      "source": "overture",
      "source-layer": "infrastructure",
      "paint": {
        "fill-color": [
          "match",
          [
            "get",
            "surface"
          ],
          "asphalt",
          "#386641",
          "concrete",
          "#6a994e",
          "paved",
          "#a7c957",
          "wood",
          "#bc4749",
          "paving_stones",
          "#f2e8cf",
          "unpaved",
          "#457b9d",
          "gravel",
          "#1d3557",
          "grass",
          "#a8dadc",
          "compacted",
          "#e63946",
          "fine_gravel",
          "#2b9348",
          "#9e9e9e"
        ],
        "fill-opacity": 0.85
      }
    },
    {
      "id": "infrastructure-outline",
      "type": "line",
      "source": "overture",
      "source-layer": "infrastructure",
      "filter": [
        "==",
        [
          "geometry-type"
        ],
        "Polygon"
      ],
      "paint": {
        "line-color": "#101418",
        "line-width": 0.3
      }
    },
    {
      "id": "infrastructure-line",
      "type": "line",
      "source": "overture",
      "source-layer": "infrastructure",
      "filter": [
        "==",
        [
          "geometry-type"
        ],
        "LineString"
      ],
      "paint": {
        "line-color": [
          "match",
          [
            "get",
            "surface"
          ],
          "asphalt",
          "#386641",
          "concrete",
          "#6a994e",
          "paved",
          "#a7c957",
          "wood",
          "#bc4749",
          "paving_stones",
          "#f2e8cf",
          "unpaved",
          "#457b9d",
          "gravel",
          "#1d3557",
          "grass",
          "#a8dadc",
          "compacted",
          "#e63946",
          "fine_gravel",
          "#2b9348",
          "#9e9e9e"
        ],
        "line-width": 1.1
      }
    },
    {
      "id": "infrastructure-point",
      "type": "circle",
      "source": "overture",
      "source-layer": "infrastructure",
      "filter": [
        "==",
        [
          "geometry-type"
        ],
        "Point"
      ],
      "paint": {
        "circle-color": [
          "match",
          [
            "get",
            "surface"
          ],
          "asphalt",
          "#386641",
          "concrete",
          "#6a994e",
          "paved",
          "#a7c957",
          "wood",
          "#bc4749",
          "paving_stones",
          "#f2e8cf",
          "unpaved",
          "#457b9d",
          "gravel",
          "#1d3557",
          "grass",
          "#a8dadc",
          "compacted",
          "#e63946",
          "fine_gravel",
          "#2b9348",
          "#9e9e9e"
        ],
        "circle-radius": 2.4,
        "circle-opacity": 0.9
      }
    }
  ]
}
