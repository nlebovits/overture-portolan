{
  "version": 8,
  "name": "Infrastructure by subtype",
  "sources": {
    "overture": {
      "type": "vector",
      "tiles": [
        "pmtiles://https://overturemaps-extras-us-west-2.s3.us-west-2.amazonaws.com/tiles/2026-08-19.0/base.pmtiles/{z}/{x}/{y}"
      ],
      "minzoom": 0,
      "maxzoom": 13,
      "attribution": "<a href=\"https://overturemaps.org/\">Overture Maps</a>, &copy; OpenStreetMap contributors"
    }
  },
  "layers": [
    {
      "id": "infrastructure-fill",
      "type": "fill",
      "source": "overture",
      "source-layer": "infrastructure",
      "paint": {
        "fill-color": [
          "match",
          [
            "get",
            "subtype"
          ],
          "transportation",
          "#9aa3a8",
          "transit",
          "#1e526b",
          "barrier",
          "#b0a377",
          "pedestrian",
          "#538400",
          "power",
          "#e89d07",
          "bridge",
          "#585f63",
          "waste_management",
          "#b5651d",
          "emergency",
          "#c03221",
          "water",
          "#4a9d9c",
          "utility",
          "#7c5295",
          "#9e9e9e"
        ],
        "fill-opacity": 0.85
      }
    },
    {
      "id": "infrastructure-outline",
      "type": "line",
      "source": "overture",
      "source-layer": "infrastructure",
      "filter": [
        "==",
        [
          "geometry-type"
        ],
        "Polygon"
      ],
      "paint": {
        "line-color": "#FFFFFF",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          5,
          0,
          7,
          0.3
        ]
      }
    },
    {
      "id": "infrastructure-line",
      "type": "line",
      "source": "overture",
      "source-layer": "infrastructure",
      "filter": [
        "==",
        [
          "geometry-type"
        ],
        "LineString"
      ],
      "paint": {
        "line-color": [
          "match",
          [
            "get",
            "subtype"
          ],
          "transportation",
          "#9aa3a8",
          "transit",
          "#1e526b",
          "barrier",
          "#b0a377",
          "pedestrian",
          "#538400",
          "power",
          "#e89d07",
          "bridge",
          "#585f63",
          "waste_management",
          "#b5651d",
          "emergency",
          "#c03221",
          "water",
          "#4a9d9c",
          "utility",
          "#7c5295",
          "#9e9e9e"
        ],
        "line-width": 1.1
      }
    },
    {
      "id": "infrastructure-point",
      "type": "circle",
      "source": "overture",
      "source-layer": "infrastructure",
      "filter": [
        "==",
        [
          "geometry-type"
        ],
        "Point"
      ],
      "paint": {
        "circle-color": [
          "match",
          [
            "get",
            "subtype"
          ],
          "transportation",
          "#9aa3a8",
          "transit",
          "#1e526b",
          "barrier",
          "#b0a377",
          "pedestrian",
          "#538400",
          "power",
          "#e89d07",
          "bridge",
          "#585f63",
          "waste_management",
          "#b5651d",
          "emergency",
          "#c03221",
          "water",
          "#4a9d9c",
          "utility",
          "#7c5295",
          "#9e9e9e"
        ],
        "circle-radius": 2.4,
        "circle-opacity": 0.9,
        "circle-stroke-color": "#FFFFFF",
        "circle-stroke-width": 0.8
      }
    }
  ]
}
