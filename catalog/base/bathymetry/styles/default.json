{
  "version": 8,
  "name": "Bathymetry by depth",
  "sources": {
    "overture": {
      "type": "vector",
      "tiles": [
        "pmtiles://https://overturemaps-extras-us-west-2.s3.us-west-2.amazonaws.com/tiles/2026-08-19.0/base.pmtiles/{z}/{x}/{y}"
      ],
      "minzoom": 0,
      "maxzoom": 13,
      "attribution": "<a href=\"https://overturemaps.org/\">Overture Maps</a>, &copy; OpenStreetMap contributors"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#101418"
      }
    },
    {
      "id": "bathymetry-fill",
      "type": "fill",
      "source": "overture",
      "source-layer": "bathymetry",
      "paint": {
        "fill-color": [
          "step",
          [
            "get",
            "depth"
          ],
          "#d7f0f7",
          10,
          "#b3e0ee",
          50,
          "#8ecae6",
          100,
          "#61b2d9",
          500,
          "#3a95c7",
          1000,
          "#2678ae",
          1500,
          "#1b5c8f",
          2000,
          "#154470",
          2500,
          "#0f2e52",
          3000,
          "#081a33"
        ],
        "fill-opacity": 0.85
      }
    },
    {
      "id": "bathymetry-outline",
      "type": "line",
      "source": "overture",
      "source-layer": "bathymetry",
      "filter": [
        "==",
        [
          "geometry-type"
        ],
        "Polygon"
      ],
      "paint": {
        "line-color": "#101418",
        "line-width": 0.3
      }
    }
  ]
}
