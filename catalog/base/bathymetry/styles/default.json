{
  "version": 8,
  "name": "Bathymetry by depth",
  "sources": {
    "overture": {
      "type": "vector",
      "tiles": [
        "pmtiles://https://overturemaps-extras-us-west-2.s3.us-west-2.amazonaws.com/tiles/2026-08-19.0/base.pmtiles/{z}/{x}/{y}"
      ],
      "minzoom": 0,
      "maxzoom": 13,
      "attribution": "<a href=\"https://overturemaps.org/\">Overture Maps</a>, &copy; OpenStreetMap contributors"
    }
  },
  "layers": [
    {
      "id": "bathymetry-fill",
      "type": "fill",
      "source": "overture",
      "source-layer": "bathymetry",
      "paint": {
        "fill-color": [
          "step",
          [
            "get",
            "depth"
          ],
          "#dfe6ea",
          10,
          "#c9dfe8",
          50,
          "#a8d4e8",
          100,
          "#8fbdd6",
          500,
          "#7fb3d0",
          1000,
          "#5591b5",
          1500,
          "#2874a6",
          2000,
          "#1e6f9c",
          2500,
          "#1e526b",
          3000,
          "#174054"
        ],
        "fill-opacity": 0.85
      }
    },
    {
      "id": "bathymetry-outline",
      "type": "line",
      "source": "overture",
      "source-layer": "bathymetry",
      "filter": [
        "==",
        [
          "geometry-type"
        ],
        "Polygon"
      ],
      "paint": {
        "line-color": "#FFFFFF",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          5,
          0,
          7,
          0.3
        ]
      }
    }
  ]
}
