  "table:columns": [
    {
      "name": "id",
      "description": "A feature ID. This may be an ID associated with the Global Entity Reference System (GERS) if\u2014and-only-if the feature represents an entity that is part of GERS."
    },
    {
      "name": "names",
      "description": "Properties defining the names of a feature. The struct carries a primary name, optional common names by language, and optional rules. Quoted from the namesContainer definition in the Overture schema."
    },
    {
      "name": "subtype",
      "description": "Further description of the type of land cover, such as forest, glacier, grass, or a physical feature, such as a mountain peak."
    },
    {
      "name": "class",
      "description": "Further classification of type of landcover"
    },
    {
      "name": "sources",
      "description": "The array of source information for the properties of a given feature, with each entry being a source object which lists the property in JSON Pointer notation. All features must have a root level source which is the default source if a specific property's source is not specified."
    },
    {
      "name": "source_tags",
      "description": "Any attributes/tags from the original source data that should be passed through."
    },
    {
      "name": "level",
      "description": "Z-order of the feature where 0 is visual level"
    },
    {
      "name": "wikidata",
      "description": "A wikidata ID if available, as found on https://www.wikidata.org/."
    },
    {
      "name": "surface",
      "description": "Surface material, mostly from the OSM tag, with some normalization."
    },
    {
      "name": "elevation",
      "description": "Elevation above sea level (in meters) of the feature."
    },
    {
      "name": "geometry",
      "description": "The feature geometry, stored as well-known binary in EPSG:4326."
    },
    {
      "name": "version",
      "description": "Version number of the feature, incremented in each Overture release where the geometry or attributes of this feature changed."
    },
    {
      "name": "bbox"
    }
  ],
