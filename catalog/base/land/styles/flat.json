{
  "version": 8,
  "name": "Land, single colour",
  "sources": {
    "overture": {
      "type": "vector",
      "tiles": [
        "pmtiles://https://overturemaps-extras-us-west-2.s3.us-west-2.amazonaws.com/tiles/2026-08-19.0/base.pmtiles/{z}/{x}/{y}"
      ],
      "minzoom": 0,
      "maxzoom": 13,
      "attribution": "<a href=\"https://overturemaps.org/\">Overture Maps</a>, &copy; OpenStreetMap contributors"
    }
  },
  "layers": [
    {
      "id": "land-fill",
      "type": "fill",
      "source": "overture",
      "source-layer": "land",
      "paint": {
        "fill-color": "#7fb356",
        "fill-opacity": 0.85
      }
    },
    {
      "id": "land-outline",
      "type": "line",
      "source": "overture",
      "source-layer": "land",
      "filter": [
        "==",
        [
          "geometry-type"
        ],
        "Polygon"
      ],
      "paint": {
        "line-color": "#FFFFFF",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          5,
          0,
          7,
          0.6
        ]
      }
    },
    {
      "id": "land-line",
      "type": "line",
      "source": "overture",
      "source-layer": "land",
      "filter": [
        "==",
        [
          "geometry-type"
        ],
        "LineString"
      ],
      "paint": {
        "line-color": "#7fb356",
        "line-width": 1.1
      }
    },
    {
      "id": "land-point",
      "type": "circle",
      "source": "overture",
      "source-layer": "land",
      "filter": [
        "==",
        [
          "geometry-type"
        ],
        "Point"
      ],
      "paint": {
        "circle-color": "#7fb356",
        "circle-radius": 2.4,
        "circle-opacity": 0.9,
        "circle-stroke-color": "#FFFFFF",
        "circle-stroke-width": 0.8
      }
    }
  ]
}
