{
  "version": 8,
  "name": "Land Use by subtype",
  "sources": {
    "overture": {
      "type": "vector",
      "tiles": [
        "pmtiles://https://overturemaps-extras-us-west-2.s3.us-west-2.amazonaws.com/tiles/2026-08-19.0/base.pmtiles/{z}/{x}/{y}"
      ],
      "minzoom": 0,
      "maxzoom": 13,
      "attribution": "<a href=\"https://overturemaps.org/\">Overture Maps</a>, &copy; OpenStreetMap contributors"
    }
  },
  "layers": [
    {
      "id": "land_use-fill",
      "type": "fill",
      "source": "overture",
      "source-layer": "land_use",
      "paint": {
        "fill-color": [
          "match",
          [
            "get",
            "subtype"
          ],
          "managed",
          "#b8c9a0",
          "recreation",
          "#7fb356",
          "residential",
          "#e0b394",
          "park",
          "#538400",
          "agriculture",
          "#d6c977",
          "horticulture",
          "#adc487",
          "developed",
          "#d0c4b0",
          "education",
          "#e89d07",
          "golf",
          "#95c68f",
          "pedestrian",
          "#c9b970",
          "#9e9e9e"
        ],
        "fill-opacity": 0.85
      }
    },
    {
      "id": "land_use-outline",
      "type": "line",
      "source": "overture",
      "source-layer": "land_use",
      "filter": [
        "==",
        [
          "geometry-type"
        ],
        "Polygon"
      ],
      "paint": {
        "line-color": "#FFFFFF",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          5,
          0,
          7,
          0.3
        ]
      }
    },
    {
      "id": "land_use-line",
      "type": "line",
      "source": "overture",
      "source-layer": "land_use",
      "filter": [
        "==",
        [
          "geometry-type"
        ],
        "LineString"
      ],
      "paint": {
        "line-color": [
          "match",
          [
            "get",
            "subtype"
          ],
          "managed",
          "#b8c9a0",
          "recreation",
          "#7fb356",
          "residential",
          "#e0b394",
          "park",
          "#538400",
          "agriculture",
          "#d6c977",
          "horticulture",
          "#adc487",
          "developed",
          "#d0c4b0",
          "education",
          "#e89d07",
          "golf",
          "#95c68f",
          "pedestrian",
          "#c9b970",
          "#9e9e9e"
        ],
        "line-width": 1.1
      }
    }
  ]
}
