{
  "version": 8,
  "name": "Land Cover by subtype",
  "sources": {
    "overture": {
      "type": "vector",
      "tiles": [
        "pmtiles://https://overturemaps-extras-us-west-2.s3.us-west-2.amazonaws.com/tiles/2026-08-19.0/base.pmtiles/{z}/{x}/{y}"
      ],
      "minzoom": 0,
      "maxzoom": 13,
      "attribution": "<a href=\"https://overturemaps.org/\">Overture Maps</a>, &copy; OpenStreetMap contributors"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#101418"
      }
    },
    {
      "id": "land_cover-fill",
      "type": "fill",
      "source": "overture",
      "source-layer": "land_cover",
      "paint": {
        "fill-color": [
          "match",
          [
            "get",
            "subtype"
          ],
          "shrub",
          "#386641",
          "barren",
          "#6a994e",
          "forest",
          "#a7c957",
          "crop",
          "#bc4749",
          "urban",
          "#f2e8cf",
          "grass",
          "#457b9d",
          "wetland",
          "#1d3557",
          "mangrove",
          "#a8dadc",
          "#9e9e9e"
        ],
        "fill-opacity": 0.85
      }
    },
    {
      "id": "land_cover-outline",
      "type": "line",
      "source": "overture",
      "source-layer": "land_cover",
      "filter": [
        "==",
        [
          "geometry-type"
        ],
        "Polygon"
      ],
      "paint": {
        "line-color": "#101418",
        "line-width": 0.3
      }
    }
  ]
}
