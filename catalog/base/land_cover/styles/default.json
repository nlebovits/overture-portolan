{
  "version": 8,
  "name": "Land Cover by subtype",
  "sources": {
    "overture": {
      "type": "vector",
      "tiles": [
        "pmtiles://https://overturemaps-extras-us-west-2.s3.us-west-2.amazonaws.com/tiles/2026-08-19.0/base.pmtiles/{z}/{x}/{y}"
      ],
      "minzoom": 0,
      "maxzoom": 13,
      "attribution": "<a href=\"https://overturemaps.org/\">Overture Maps</a>, &copy; OpenStreetMap contributors"
    }
  },
  "layers": [
    {
      "id": "land_cover-fill",
      "type": "fill",
      "source": "overture",
      "source-layer": "land_cover",
      "paint": {
        "fill-color": [
          "match",
          [
            "get",
            "subtype"
          ],
          "shrub",
          "#adc487",
          "barren",
          "#e0d59f",
          "forest",
          "#7fb356",
          "crop",
          "#d6c977",
          "urban",
          "#d0c4b0",
          "grass",
          "#95c68f",
          "wetland",
          "#8fc6c0",
          "mangrove",
          "#4a9d9c",
          "#9e9e9e"
        ],
        "fill-opacity": 0.85
      }
    },
    {
      "id": "land_cover-outline",
      "type": "line",
      "source": "overture",
      "source-layer": "land_cover",
      "filter": [
        "==",
        [
          "geometry-type"
        ],
        "Polygon"
      ],
      "paint": {
        "line-color": "#FFFFFF",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          5,
          0,
          7,
          0.3
        ]
      }
    }
  ]
}
