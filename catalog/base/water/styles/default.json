{
  "version": 8,
  "name": "Water by subtype",
  "sources": {
    "overture": {
      "type": "vector",
      "tiles": [
        "pmtiles://https://overturemaps-extras-us-west-2.s3.us-west-2.amazonaws.com/tiles/2026-08-19.0/base.pmtiles/{z}/{x}/{y}"
      ],
      "minzoom": 0,
      "maxzoom": 13,
      "attribution": "<a href=\"https://overturemaps.org/\">Overture Maps</a>, &copy; OpenStreetMap contributors"
    }
  },
  "layers": [
    {
      "id": "water-fill",
      "type": "fill",
      "source": "overture",
      "source-layer": "water",
      "paint": {
        "fill-color": [
          "match",
          [
            "get",
            "subtype"
          ],
          "human_made",
          "#c9a0d6",
          "stream",
          "#5591b5",
          "canal",
          "#4a9d9c",
          "water",
          "#a8d4e8",
          "pond",
          "#7fb3d0",
          "river",
          "#1e6f9c",
          "reservoir",
          "#8fbdd6",
          "physical",
          "#8fc6c0",
          "spring",
          "#95d0c8",
          "lake",
          "#2874a6",
          "#9e9e9e"
        ],
        "fill-opacity": 0.85
      }
    },
    {
      "id": "water-outline",
      "type": "line",
      "source": "overture",
      "source-layer": "water",
      "filter": [
        "==",
        [
          "geometry-type"
        ],
        "Polygon"
      ],
      "paint": {
        "line-color": "#FFFFFF",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          5,
          0,
          7,
          0.3
        ]
      }
    },
    {
      "id": "water-line",
      "type": "line",
      "source": "overture",
      "source-layer": "water",
      "filter": [
        "==",
        [
          "geometry-type"
        ],
        "LineString"
      ],
      "paint": {
        "line-color": [
          "match",
          [
            "get",
            "subtype"
          ],
          "human_made",
          "#c9a0d6",
          "stream",
          "#5591b5",
          "canal",
          "#4a9d9c",
          "water",
          "#a8d4e8",
          "pond",
          "#7fb3d0",
          "river",
          "#1e6f9c",
          "reservoir",
          "#8fbdd6",
          "physical",
          "#8fc6c0",
          "spring",
          "#95d0c8",
          "lake",
          "#2874a6",
          "#9e9e9e"
        ],
        "line-width": 1.1
      }
    },
    {
      "id": "water-point",
      "type": "circle",
      "source": "overture",
      "source-layer": "water",
      "filter": [
        "==",
        [
          "geometry-type"
        ],
        "Point"
      ],
      "paint": {
        "circle-color": [
          "match",
          [
            "get",
            "subtype"
          ],
          "human_made",
          "#c9a0d6",
          "stream",
          "#5591b5",
          "canal",
          "#4a9d9c",
          "water",
          "#a8d4e8",
          "pond",
          "#7fb3d0",
          "river",
          "#1e6f9c",
          "reservoir",
          "#8fbdd6",
          "physical",
          "#8fc6c0",
          "spring",
          "#95d0c8",
          "lake",
          "#2874a6",
          "#9e9e9e"
        ],
        "circle-radius": 2.4,
        "circle-opacity": 0.9,
        "circle-stroke-color": "#FFFFFF",
        "circle-stroke-width": 0.8
      }
    }
  ]
}
